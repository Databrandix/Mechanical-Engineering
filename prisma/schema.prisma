generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════
//  AUTH  (Better Auth, no admin plugin, no verification table,
//         no emailVerified — stripped at Prisma extension layer)
// ════════════════════════════════════════════════════════════════

enum Role {
  super_admin
  admin
}

// TS source uses 'full-time' / 'part-time' (hyphenated). Prisma
// enum identifiers disallow hyphens, so we use underscores here;
// seed + admin layer maps `'full-time'` ↔ `full_time`.
enum FacultyType {
  leadership
  full_time
  part_time
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String

  role        Role      @default(admin)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// ════════════════════════════════════════════════════════════════
//  CONTENT — SINGLETONS
// ════════════════════════════════════════════════════════════════

model DepartmentIdentity {
  id                 String   @id @default("singleton")
  name               String
  shortCode          String
  facultyName        String
  primaryColor       String
  accentColor        String
  buttonColor        String
  logoUrl            String
  logoPublicId       String?
  breadcrumbLabel    String
  heroImage1Url      String
  heroImage1PublicId String?
  heroImage1Alt      String?
  heroImage2Url      String
  heroImage2PublicId String?
  heroImage2Alt      String?
  heroImage3Url      String
  heroImage3PublicId String?
  heroImage3Alt      String?
  updatedAt          DateTime @updatedAt

  @@map("department_identity")
}

model UniversityIdentity {
  id            String   @id @default("singleton")
  name          String
  address       String   @db.Text
  phones        String[]
  emails        String[]
  facebookUrl   String?
  instagramUrl  String?
  youtubeUrl    String?
  linkedinUrl   String?
  xUrl          String?
  tiktokUrl     String?
  whatsappUrl   String?
  threadsUrl    String?
  erpUrl        String?
  applyUrl      String?
  libraryUrl    String?
  iqacUrl       String?
  careerUrl     String?
  noticeUrl     String?
  copyrightText String
  mapEmbedUrl   String?  @db.Text
  logoUrl       String
  logoPublicId  String?
  updatedAt     DateTime @updatedAt

  @@map("university_identity")
}

// ════════════════════════════════════════════════════════════════
//  CONTENT — LISTS
// ════════════════════════════════════════════════════════════════

model Program {
  id              String   @id @default(cuid())
  programName     String
  degreeCode      String   @unique
  duration        String
  description     String   @db.Text
  displayOrder    Int

  imageUrl        String?
  imagePublicId   String?
  specializations String[]
  cta             String?
  ctaHref         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayOrder])
  @@map("program")
}

model ResearchArea {
  id           String   @id @default(cuid())
  iconName     String?
  iconPublicId String?
  iconUrl      String?
  areaName     String
  description  String?  @db.Text
  displayOrder Int

  // Featured slot — exactly one row should have isFeatured=true.
  // Renders into the right-hand card on MajorResearchSection.
  // featuredHeading is optional override for the card's <h3>; null →
  // renderer falls back to areaName (keeps grid + featured visually
  // in sync unless an editor intentionally wants a richer title).
  isFeatured              Boolean @default(false)
  featuredHeading         String?
  featuredImageUrl        String?
  featuredImagePublicId   String?
  featuredDescription     String? @db.Text
  featuredCtaHref         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([isFeatured])
  @@map("research_area")
}

// Faculty — Phase 2. Drives /faculty-member (list + [slug] detail)
// and the Dean's-message / Head's-message about pages via
// nullable message-extras columns on the same row.
model Faculty {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  designation     String
  secondaryTitle  String?
  badge           String?
  type            FacultyType
  displayOrder    Int

  // Photo (Cloudinary-paired, same convention as Program.imageUrl)
  photoUrl        String?
  photoPublicId   String?

  // Contact (all optional)
  email           String?
  phone           String?
  suId            String?

  // Variable-shape label/value list — `{label, value}[]`
  personalInfo    Json?

  // 8 detail sections — each can be:
  //   string | string[] | { heading: string; items: string[] }[]
  // Json is the only realistic storage for that union.
  academicQualification  Json?
  trainingExperience     Json?
  teachingArea           Json?
  publications           Json?
  research               Json?
  awards                 Json?
  membership             Json?
  previousEmployment     Json?

  // Dean / Head extras — flat nullable columns; only the 0–1 row(s)
  // flagged isDean / isHead populate these.
  isDean                    Boolean   @default(false)
  isHead                    Boolean   @default(false)
  messageOverline           String?
  messageHeading            String?
  messageParagraphs         String[]
  messagePhotoUrl           String?
  messagePhotoPublicId      String?
  messageTitleLine1         String?
  messageTitleLine2         String?
  messageHeroImageUrl       String?
  messageHeroImagePublicId  String?
  messageHeroImagePosition  String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([type, displayOrder])
  @@index([isDean])
  @@index([isHead])
  @@map("faculty")
}

// ════════════════════════════════════════════════════════════════
//  CHROME — NAVBAR + FOOTER STRUCTURE
//  Phase 3. Drives navbar (top bar, quick-access grid, main nav
//  groups + items) and footer (4 link columns). Everything that
//  was a hardcoded array in Navbar.tsx / Footer.tsx now lives here.
// ════════════════════════════════════════════════════════════════

model TopLink {
  // The thin top-bar row above the main navbar (Virtual Tour, IQAC,
  // Career, Archive, Contact). Hidden on mobile; collapses on scroll.
  id           String   @id @default(cuid())
  name         String
  href         String?  // null when isDisabled (e.g. "Virtual Tour", "Archive" have no destination yet)
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("top_link")
}

model QuickAccessItem {
  // The 3-col grid in scrolled-navbar's right dropdown + mobile
  // drawer "Services" section. Single source of truth — both
  // surfaces render from this list.
  id           String   @id @default(cuid())
  name         String
  href         String?
  iconName     String   // Lucide icon name (BookOpen, GraduationCap, …)
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("quick_access_item")
}

model MainNavGroup {
  // Each entry on the main nav bar (About, Faculty Member, Admission,
  // Student Society, Contact). `hasDropdown=false` → plain link
  // (href required, items empty). `hasDropdown=true` → dropdown
  // panel (href ignored, title + items drive the panel).
  id           String        @id @default(cuid())
  name         String
  href         String?
  hasDropdown  Boolean       @default(false)
  title        String?       // dropdown header text (usually same as name)
  displayOrder Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        MainNavItem[]

  @@index([displayOrder])
  @@map("main_nav_group")
}

model MainNavItem {
  id           String       @id @default(cuid())
  groupId      String
  name         String
  href         String
  isExternal   Boolean      @default(false)
  isDisabled   Boolean      @default(false)
  displayOrder Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  group        MainNavGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, displayOrder])
  @@map("main_nav_item")
}

model FooterUsefulLink {
  id           String   @id @default(cuid())
  name         String
  href         String?
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("footer_useful_link")
}

model FooterGetInTouchLink {
  id           String   @id @default(cuid())
  name         String
  href         String?
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("footer_get_in_touch_link")
}

model FooterQuickLink {
  id           String   @id @default(cuid())
  name         String
  href         String?
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("footer_quick_link")
}

model FooterLegalLink {
  // Bottom-bar row (Privacy Statement, Terms of Use, Sitemap).
  // Flagged Phase 2/3 candidate in CP1.2 trade-offs; folded into
  // the Phase 3 full chrome sweep.
  id           String   @id @default(cuid())
  name         String
  href         String?
  isExternal   Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("footer_legal_link")
}

// ════════════════════════════════════════════════════════════════
//  ABOUT PAGES  (Phase 4)
//    Three singleton models — one per editable About page.
//    Lab pages (/about/lab-facility, /about/laboratory-facility)
//    are multi-row and deferred to Phase 5 in their entirety
//    (landing singletons + Lab list tables together).
// ════════════════════════════════════════════════════════════════

model AboutOverview {
  id                String   @id @default("singleton")
  // Hero (PageShell)
  heroTitle         String
  heroSubtitle      String?
  heroOverline      String?
  heroImageUrl      String
  heroImagePublicId String?
  heroImagePosition String?
  // Body — variable-length list of paragraph bodies (HTML allowed)
  paragraphs        String[]
  updatedAt         DateTime @updatedAt

  @@map("about_overview")
}

model AboutMissionVision {
  id                String   @id @default("singleton")
  // Hero
  heroTitle         String
  heroOverline      String?
  heroImageUrl      String
  heroImagePublicId String?
  heroImagePosition String?
  // Mission card
  missionOverline   String?
  missionHeading    String
  missionBody       String   @db.Text
  // Vision card
  visionOverline    String?
  visionHeading     String
  visionBody        String   @db.Text
  updatedAt         DateTime @updatedAt

  @@map("about_mission_vision")
}

model AboutMechaClub {
  id                       String   @id @default("singleton")
  // Hero
  heroTitle                String
  heroOverline             String?
  heroImageUrl             String
  heroImagePublicId        String?
  heroImagePosition        String?
  // Intro section
  introOverline            String?
  // introHeading allows inline HTML (e.g. <span class="text-gradient">)
  // — rendered via dangerouslySetInnerHTML on the public side (J1
  // pattern from Phase 2 messageParagraphs). Author trust is the
  // operational control while audience is the chair.
  introHeading             String
  introBody1               String   @db.Text
  introBody2               String   @db.Text
  introImageUrl            String
  introImagePublicId       String?
  // Stats — variable-length [{ value, label }]
  stats                    Json
  // Activities section
  activitiesOverline       String?
  activitiesHeading        String
  // Activities — variable-length [{ iconName, imageUrl, imagePublicId?, category, title, description }]
  // iconName resolved against a curated Lucide IconMap at render
  // time (same pattern as Phase 3 QuickAccessItem.iconName).
  activities               Json
  // Network section + 2 CTAs
  networkOverline          String?
  networkHeading           String
  networkBody              String   @db.Text
  networkPrimaryCtaLabel   String
  networkPrimaryCtaHref    String
  networkSecondaryCtaLabel String?
  networkSecondaryCtaHref  String?
  updatedAt                DateTime @updatedAt

  @@map("about_mecha_club")
}

// ════════════════════════════════════════════════════════════════
//  LAB SYSTEMS  (Phase 5)
//    Two parallel multi-row systems — intentional separation, not
//    duplication. /about/lab-facility is slug-based detail UX;
//    /about/laboratory-facility is grid-of-cards. Confirmed by
//    chair as distinct content concepts.
// ════════════════════════════════════════════════════════════════

// ─── System 1 — /about/lab-facility (slug-based detail) ───────

model LabFacilityLanding {
  id                String   @id @default("singleton")
  // Hero (PageShell)
  heroTitle         String              // "Lab Facilities"
  heroOverline      String?             // "About"
  heroImageUrl      String
  heroImagePublicId String?
  heroImagePosition String?             // "center 25%"
  // Intro paragraph (HTML allowed, same convention as Phase 4 AboutOverview)
  introBody         String   @db.Text
  updatedAt         DateTime @updatedAt

  @@map("lab_facility_landing")
}

model Lab {
  id                String   @id @default(cuid())
  slug              String   @unique   // URL-hash deep link target
  name              String
  tagline           String   @db.Text
  description       String   @db.Text
  heroImageUrl      String?
  heroImagePublicId String?
  // Gallery — paired arrays. gallery[i] is the URL, galleryPublicIds[i]
  // is the Cloudinary public_id for cleanup. Same length, or both
  // empty when no gallery is set. Seed populates gallery from
  // labs-data.ts URLs and leaves galleryPublicIds empty (local
  // /assets/ paths have no Cloudinary id).
  gallery           String[]
  galleryPublicIds  String[]
  displayOrder      Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([displayOrder])
  @@map("lab")
}

// ─── System 2 — /about/laboratory-facility (grid + features) ──

model LaboratoryFacilityLanding {
  id                String   @id @default("singleton")
  // Hero
  heroTitle         String              // "Laboratory Facility"
  heroOverline      String?             // "About"
  heroImageUrl      String
  heroImagePublicId String?
  heroImagePosition String?
  // Intro
  introBody         String   @db.Text
  // "Why Our Labs Matter" — features section on the landing
  featuresOverline  String?             // "What Sets Us Apart"
  featuresHeading   String              // "Why Our Labs Matter"
  // features — [{ iconName, title, description }] variable list
  // Same Json shape pattern as Phase 4 AboutMechaClub.activities;
  // iconName resolved against IconMap at render time with
  // FlaskConical fallback.
  features          Json
  updatedAt         DateTime @updatedAt

  @@map("laboratory_facility_landing")
}

model LaboratoryLab {
  id           String   @id @default(cuid())
  iconName     String                // Lucide name ("Flame", "Droplets", …)
  title        String
  description  String   @db.Text
  keyLabel     String                // "Key Equipment" / "Key Software" / "Key Processes"
  // keyItems — single comma-separated sentence, rendered as one
  // <p>. Discovery #2 surfaced that the current data is plain
  // String, not String[], so the column matches the render shape.
  keyItems     String   @db.Text
  focus        String   @db.Text
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("laboratory_lab")
}

// ════════════════════════════════════════════════════════════════
//  Phase 6 — Content hubs (News, Events, Notices, Gallery)
//    Four multi-row entities driving the ongoing-content surfaces:
//      /news + /news/[slug]
//      /student-society/events + /[slug]
//      /student-society/notice-board (list only; file is the artifact)
//      /gallery (lightbox-on-list, flat — no albums per Decision A)
//    Homepage cross-refs: NewsSection (5), EventsSection (3),
//    NoticesSection (5). Gallery has no homepage section.
// ════════════════════════════════════════════════════════════════

model News {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortTitle    String
  // category — Academic | Achievement | Event | Workshop | Seminar | Industrial Visit
  // Validated via Zod against the closed set; stored as String for forward
  // flexibility (matches Phase 2 Faculty designation pattern).
  category      String
  // publishedAt — structured date used for sort + auto-formatted display
  // when displayDate is null. Required so list ordering is deterministic.
  publishedAt   DateTime
  // displayDate — admin override (e.g. "2024" when only the year is known
  // or admin wants a custom format). Null = derive from publishedAt.
  displayDate   String?
  summary       String   @db.Text
  coverUrl      String
  coverPublicId String?
  // body — Json string[]: paragraph array. Same shape as the legacy
  // news-data.ts. Reuses the Phase 2 Faculty paragraph editor.
  body          Json
  // meta — Json [{label,value}]: optional extra rows (Participants /
  // Location / Period / Organising Partner …). Defaults to empty array.
  meta          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publishedAt])
  @@map("news")
}

model Event {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  shortTitle    String
  // category — Sports | Industrial Visit | Achievement | Partnership | Seminar | Exhibition
  category      String
  // status — Past | Current | Upcoming. Admin sets manually (no auto-derive
  // from eventDate). Matches the existing render which has events with
  // null dates marked Current.
  status        String
  // eventDate — nullable; some events have no fixed date (e.g. "current
  // partnerships"). Sort ordering: eventDate DESC NULLS LAST, createdAt DESC.
  eventDate     DateTime?
  // displayDate — admin override (e.g. "20 Apr", "2024"). Null = derive
  // from eventDate, both null = hide the date pill.
  displayDate   String?
  time          String?
  venue         String?
  imageUrl      String
  imagePublicId String?
  summary       String    @db.Text
  // description — Json string[]: paragraphs for the detail page.
  description   Json
  focus         String    @db.Text
  // details — Json [{label,value}]: optional "Chief Guest / Chairperson /
  // Date / Venue" sidebar rows. Defaults to empty array.
  details       Json
  ctaLabel      String?
  ctaHref       String?
  ctaExternal   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([eventDate])
  @@index([status])
  @@map("event")
}

model Notice {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  // category — Academic | Holiday | Transport
  category     String
  department   String                  // e.g. "Office of the Registrar"
  publishedAt  DateTime
  displayDate  String?
  description  String   @db.Text
  // File attachment — nullable so admin can save metadata-only initially.
  // Upload flow: Cloudinary auto/upload accepts both image (jpg/png/webp)
  // and PDF; fileType is set from the response resource_type or extension
  // so the public renderer can show the right icon (Image vs FileText).
  fileUrl      String?
  filePublicId String?
  fileType     String?                 // 'image' | 'pdf'
  fileName     String?                 // original filename for the <a download> attribute
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
  @@map("notice")
}

model GalleryImage {
  id            String   @id @default(cuid())
  imageUrl      String
  imagePublicId String?
  alt           String
  // width/height — required for the masonry grid's aspect-ratio
  // calculation (matches the legacy gallery-data.ts dimensions array).
  width         Int
  height        Int
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("gallery_image")
}

// ════════════════════════════════════════════════════════════════
//  Phase 7 — Student Society + Transport (final CMS migration)
//    7 multi-row entities + 1 singleton, all replacing the last
//    file-based reads from src/lib/*-data.ts.
//    After Phase 7, every visible public surface is DB-driven
//    (only /admission/* singletons remain hardcoded for Phase 8).
// ════════════════════════════════════════════════════════════════

model Alumni {
  id            String   @id @default(cuid())
  slug          String   @unique
  studentId     String
  name          String
  department    String
  designation   String
  company       String
  photoUrl      String?
  photoPublicId String?
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("alumni")
}

model Club {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  abbreviation  String
  description   String   @db.Text
  imageUrl      String
  imagePublicId String?
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("club")
}

model Faq {
  id           String   @id @default(cuid())
  // category — Admission | Rankings | Campus | Programs | Exams.
  // Validated via Zod against the closed set; stored as String for
  // forward flexibility (matches Phase 2 / Phase 6 enum-as-string).
  category     String
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([category])
  @@map("faq")
}

model Visitor {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  role          String?
  affiliation   String?
  photoUrl      String
  photoPublicId String?
  // quote — Json string[] paragraphs (reuses Phase 2 ParagraphsEditor
  // and Phase 6 coerceParagraphs read defence). Single-paragraph rows
  // store as `[string]`, multi-paragraph as `[string, string, …]`.
  quote         Json
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("visitor")
}

model ResearchPaper {
  id              String   @id @default(cuid())
  title           String   @db.Text
  authors         String   @db.Text
  area            String   @db.Text
  // date — free-form string. Source data has inconsistent formats:
  // "14 August 2019", "January–February 2023", "2023", "" (empty).
  // No DateTime parse; publicationYear below is the optional
  // structured sort key.
  date            String?
  publicationYear Int?
  displayOrder    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayOrder])
  @@index([publicationYear])
  @@map("research_paper")
}

model BusRoute {
  id             String   @id @default(cuid())
  slug           String   @unique
  routeName      String                       // "Technical → SU"
  busNumber      String
  contact        String
  // String[] paired arrays; admin form serializes via JSON-encoded
  // hidden input (same pattern as Phase 5 GalleryEditor).
  departureTimes String[]
  returnTimes    String[]
  displayOrder   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([displayOrder])
  @@map("bus_route")
}

model Syllabus {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortTitle    String
  department    String
  // level — 'Undergraduate' | 'Postgraduate'. Zod-validated.
  level         String
  coverUrl      String
  coverPublicId String?
  // PDF attachment — nullable so admin can save metadata-only first.
  // Cloudinary raw resource type via accept='application/pdf'
  // (reuses Phase 6 ImageUploader extension).
  pdfUrl        String?
  pdfPublicId   String?
  pdfFileName   String?
  summary       String   @db.Text
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("syllabus")
}

// Singleton — the chrome around the BusRoute grid on /transport-service.
// introBody + bannerHeading/bannerBody + instructions are the three
// hardcoded blocks the page wraps around the data-driven grid.
model TransportLanding {
  id            String   @id @default("singleton")
  introBody     String   @db.Text
  bannerHeading String
  bannerBody    String   @db.Text
  // instructions Json: [{iconName, title, body}] — 3 rows
  // (MapPin / Sparkles / Bus icons in current render). Reuses the
  // Phase 5 LaboratoryFacility "features" Json shape.
  instructions  Json
  updatedAt     DateTime @updatedAt

  @@map("transport_landing")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 8a — Admission CMS Part 1 (Notices + Prospectus)
// ─────────────────────────────────────────────────────────────────

// Formal Registrar letterhead documents. Multi-row;
// /admission/notice renders the latest isActive=true row ordered by
// publishedAt DESC. No public archive route in Phase 8a (Decision
// B1) — admin toggles isActive to swap the visible notice.
model AdmissionNotice {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  refNo                 String
  subject               String
  publishedAt           DateTime
  displayDate           String?

  headerOverline        String   @default("Office of the Registrar")

  // Json string[] of HTML-safe paragraphs (inline <strong>/<em>
  // allowed via dangerouslySetInnerHTML, author-trust caveat from
  // Phase 7 TransportLanding pattern).
  bodyParagraphs        Json

  signatoryPreamble     String?
  signatoryName         String
  signatoryDesignation  String

  ccLabel               String   @default("Copy for Kind Information (not according to seniority)")
  ccList                Json

  heroImageUrl          String?
  heroImagePublicId     String?

  fileUrl               String?
  filePublicId          String?
  fileName              String?

  isActive              Boolean  @default(true)
  displayOrder          Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([publishedAt])
  @@index([isActive, publishedAt])
  @@map("admission_notice")
}

// One row per program prospectus PDF. Mirrors Phase 7 Syllabus
// shape 1:1 — separate tables (Decision D) because a program may
// have both a syllabus and a prospectus, so a shared slug would
// collide. /admission/prospectus surfaces all rows with a UG/PG
// filter (client-side, same as the original hardcoded page).
model ProspectusEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortTitle    String
  department    String
  // level — 'Undergraduate' | 'Postgraduate'. Zod-validated.
  level         String
  coverUrl      String
  coverPublicId String?
  pdfUrl        String?
  pdfPublicId   String?
  pdfFileName   String?
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@index([level])
  @@map("prospectus_entry")
}
