# Build-time credentials for me-deploy.service.
#
#   sudo install -d -o root -g root -m 0700 /etc/me-platform
#   sudo install -o root -g root -m 0600 /dev/null /etc/me-platform/build.env
#   sudo nano /etc/me-platform/build.env
#
# Root-owned, mode 0600. systemd reads it as root before dropping to
# User=deploy, so the build gets these values in its environment while the
# deploy account can never read the file itself.
#
# ONLY these two keys belong here. The build prerenders database-backed pages,
# so it needs Postgres; it has no use for BETTER_AUTH_SECRET, CLOUDINARY_*,
# RESEND_API_KEY or INITIAL_SUPER_ADMIN_PASSWORD, and those stay in the
# runtime-only .env.production. Adding them here would hand the build — and so
# the deploy account — secrets it does not need.
#
# Plain KEY=value lines only: systemd does not evaluate `export`, shell
# expansion, or multi-line values, and treats a trailing `# comment` after a
# value as part of the value.
#
# DATABASE_URL also appears in .env.production, because the running app needs
# it too. Rotating the database credential means editing BOTH files.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
