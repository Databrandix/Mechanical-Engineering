# Pull-based deployment for me.su.edu.bd. Runs once per timer tick, checks
# whether origin/main has moved, and deploys only if it has.
#
#   sudo install -o root -g root -m 0755 deploy/auto-deploy.sh /usr/local/bin/me-deploy
#   sudo cp deploy/me-deploy.service deploy/me-deploy.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start me-deploy            # dry run before enabling the timer
#   sudo systemctl enable --now me-deploy.timer
#   journalctl -u me-deploy -f
#
# Runs as me-build, an account that exists only to build this one site. It is
# deliberately NOT the `deploy` account: `deploy` owns /var/www/sites/su.edu.bd
# and belongs to su-web, so a build running as `deploy` could rewrite the main
# university site. me-build owns the ME release and nothing else.
[Unit]
Description=Check for new commits and deploy me.su.edu.bd
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=me-build
Group=me-build
# me-build must also be a member of me-web. Changing a file's group requires
# membership of the target group, and the post-build step hands the ISR server
# tree to me-web so the running service can write regenerated pages into it.

# Build-time database credentials, and nothing else. systemd reads this file as
# root before dropping to User=, so the build receives the values in its
# environment while me-build can never read the file. Runtime secrets are not
# here on purpose: the build has no use for BETTER_AUTH_SECRET,
# CLOUDINARY_API_SECRET, RESEND_API_KEY or INITIAL_SUPER_ADMIN_PASSWORD, so it
# never sees them. Those stay in .env.production, read only by me-platform.
EnvironmentFile=/etc/me-platform/build.env

Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

WorkingDirectory=/var/www/sites/me.su.edu.bd
ExecStart=/usr/local/bin/me-deploy

# me-build has no home directory, and ProtectHome= hides /home in any case, so
# npm and Next.js have nowhere of their own to write. systemd supplies both
# directories, creates them owned by the service user, and exports the paths.
StateDirectory=me-build
CacheDirectory=me-build
Environment=HOME=%S/me-build
Environment=npm_config_cache=%C/me-build

# The deploy script takes its lock here; systemd exports the path as
# $RUNTIME_DIRECTORY and removes the directory when the unit stops.
RuntimeDirectory=me-deploy
RuntimeDirectoryMode=0700

# A cold npm ci plus a full Next build. Generous, but bounded.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=me-deploy

# ---------------------------------------------------------------- hardening
ProtectHome=yes
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The whole filesystem is read-only except the two paths below. This is what
# actually enforces the boundary against the neighbouring su.edu.bd deployment:
# not ownership, not group membership, but the kernel refusing the write. It
# holds even if the script is replaced or the build runs hostile code, and it
# requires no change of any kind to SU's files, permissions or service.
#
# StateDirectory, CacheDirectory, RuntimeDirectory and PrivateTmp remain
# writable on their own; they do not need listing here.
ProtectSystem=strict
ReadWritePaths=/var/www/sites/me.su.edu.bd
ReadWritePaths=/var/www/sites/me-platform-cache

# sudo needs this even though the rule is NOPASSWD. It opens its timestamp file
# under /run/sudo/ts before checking whether authentication is required at all,
# and with the rest of the filesystem read-only that open fails -- at which
# point sudo falls back to asking for a password and `sudo -n` dies. The
# failure reads as "a password is required", which sends you looking at the
# sudoers rule rather than at the sandbox. Verified against the real unit:
#
#   sudo: unable to open /run/sudo/ts/995: Read-only file system
#   sudo: a password is required
#
# Scope is sudo's own timestamp directory; nothing else under /run becomes
# writable.
ReadWritePaths=/run/sudo

# Two settings are deliberately absent, and adding them breaks this unit:
#
#   NoNewPrivileges   blocks the setuid transition sudo needs, and the last
#                     step of a deployment restarts the service through sudo.
#   RestrictSUIDSGID  blocks `chmod g+s`, which the ISR permission repair sets
#                     on the server/ directories so that route directories
#                     created at runtime inherit the me-web group.
