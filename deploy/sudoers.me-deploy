# Installed as /etc/sudoers.d/me-deploy, owner root:root, mode 0440.
#
#   sudo visudo -c -f deploy/sudoers.me-deploy
#   sudo install -o root -g root -m 0440 deploy/sudoers.me-deploy /etc/sudoers.d/me-deploy
#
# Validate with visudo BEFORE installing: a malformed file in sudoers.d can
# lock every account out of sudo.
#
# This single line is the whole privilege boundary of the deployment system.
# The path is absolute and exact (`command -v systemctl` on Ubuntu 24.04 gives
# /usr/bin/systemctl), and the unit name is spelled out in full. No wildcard,
# because `systemctl restart *` would also cover su-platform.service.
#
# What this deliberately does NOT grant: nginx, apt, any shell, any filesystem
# command, and any unit other than me-platform.service. Even if the deploy
# script were replaced entirely, it cannot stop the su.edu.bd site, reload
# Nginx, or install software.
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart me-platform.service
